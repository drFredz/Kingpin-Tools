<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="kpbsp" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release Win32">
				<Option output="../release/kpbsp" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/win32" />
				<Option type="0" />
				<Option compiler="gcc-msys2-mingw32" />
				<Compiler>
					<Add directory="../../common" />
				</Compiler>
				<Linker>
					<Add option="-lm" />
				</Linker>
			</Target>
			<Target title="Release Win64">
				<Option output="../release/kpbsp64" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/win64" />
				<Option type="0" />
				<Option compiler="gcc-msys2-mingw64" />
				<Compiler>
					<Add option="-m64" />
					<Add directory="../../common" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add option="-lm" />
				</Linker>
			</Target>
			<Target title="Debug Win32">
				<Option output="kpbsp" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/debug-win32" />
				<Option type="0" />
				<Option compiler="gcc-msys2-mingw32" />
				<Compiler>
					<Add directory="../../common" />
				</Compiler>
			</Target>
		</Build>
		<Unit filename="../../common/bspfile.c">

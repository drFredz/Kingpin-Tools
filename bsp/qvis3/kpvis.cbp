<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="kpvis" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release Win32">
				<Option output="../release/kpvis" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/win32" />
				<Option type="0" />
				<Option compiler="gcc-msys2-mingw32" />
				<Compiler>
					<Add directory="../../common" />
				</Compiler>
				<Linker>
					<Add option="-lm" />
				</Linker>
			</Target>
			<Target title="Release Win64">
				<Option output="../release/kpvis64" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/win64" />
				<Option type="0" />
				<Option compiler="gcc-msys2-mingw64" />
				<Compiler>
					<Add option="-m64" />
					<Add directory="../../common" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add option="-lm" />
				</Linker>
			</Target>
			<Target title="Debug Win32">
				<Option output="kpvis" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/debug-win32" />
				<Option type="0" />
				<Option compiler="gcc-msys2-mingw32" />
				<Compiler>
					<Add directory="../../common" />
				</Compiler>
			</Target>
		</Build>
		<Unit filename="../../common/bspfile.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../../common/bspfile.h" />
		<Unit filename="../../common/cmdlib.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../../common/cmdlib.h" />
		<Unit filename="../../common/l3dslib.h" />
		<Unit filename="../../common/lbmlib.h" />
		<Unit filename="../../common/mathlib.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../../common/mathlib.h" />
		<Unit filename="../../common/mdfour.h" />
		<Unit filename="../../common/polylib.h" />
		<Unit filename="../../common/qfiles.h" />
		<Unit filename="../../common/scriplib.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../../common/scriplib.h" />
		<Unit filename="../../common/threads.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../../common/threads.h" />
		<Unit filename="../../common/trilib.h" />
		<Unit filename="flow.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="qvis3.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="vis.h" />
		<Extensions>
			<code_completion />
			<debugger />
			<envvars />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
